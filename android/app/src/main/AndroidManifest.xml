<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 읽을 앱을 고르는 화면에서 설치된 앱 목록(런처 아이콘이 있는 앱)을 보여주기 위함 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:theme="@style/Theme.Gagyebbuu">

        <!-- 크롬이 이 앱과 사이트의 연결(assetlinks.json)을 확인하는 데 쓴다 -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!-- 웹앱을 크롬 Trusted Web Activity 로 여는 시작 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gagyebbuu.Launcher">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="https://gagyebbuu.vercel.app/" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/bar_light" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK" android:resource="@color/bar_dark" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/bar_light" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK" android:resource="@color/bar_dark" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 초대 링크 등 웹앱 주소를 이 앱으로 열 수 있게 한다 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gagyebbuu.vercel.app" />
            </intent-filter>
        </activity>

        <!-- 설정 > 앱 > 저장공간 '데이터 관리'에서 크롬의 사이트 데이터 화면을 연다 -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:enabled="false"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL" android:value="https://gagyebbuu.vercel.app/" />
        </activity>
        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />
        <activity android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity" android:configChanges="orientation|screenSize" />
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />

        <!-- 웹 푸시 알림을 크롬 대신 이 앱 이름/아이콘으로 띄우고, 알림 권한 요청을 이 앱으로 받는다 -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.SMALL_ICON" android:resource="@drawable/ic_stat_coin" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 알림 자동 감지 설정. 웹의 intent://settings?token=... 링크로 열리며 로그인 토큰을 받는다 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Gagyebbuu.Settings">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gagyebbuu" android:host="settings" />
            </intent-filter>
        </activity>

        <service
            android:name=".TxListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
